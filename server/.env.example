# Copy to .env and fill in your own values. Never commit .env.
# Restricted portfolio_app connection for Prisma runtime (pooled, transaction mode).
# Production/Vercel must use the least-privilege role here.
DATABASE_URL="postgresql://portfolio_app:password@host-pooler.region.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Owner connection used only by Prisma migrations/schema administration.
# Do not make this credential available to runtime code where migrations are not run.
DIRECT_URL="postgresql://neondb_owner:password@host.region.neon.tech/neondb?sslmode=require"

# Used only by the manual least-privilege verification command.
EXPECTED_RUNTIME_DB_ROLE="portfolio_app"

PORT=3001

# Generate a strong random value, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me"

# Optional when the browser frontend is hosted on a different origin.
# Production Vercel rewrites are same-origin and do not require this.
FRONTEND_URL=""

# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Server-side Gemini key from Google AI Studio. Never prefix it with VITE_.
GEMINI_API_KEY=""
# Optional model override for the recruiter assistant.
GEMINI_MODEL="gemini-3.5-flash"
# Canonical production portfolio URL used in generated CV links (never localhost).
PUBLIC_SITE_URL="https://your-production-domain.example"
