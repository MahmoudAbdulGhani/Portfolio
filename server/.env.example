# Copy to .env and fill in your own values. Never commit .env.
# Neon PostgreSQL connection for Prisma runtime (pooled, transaction mode)
DATABASE_URL="postgresql://user:password@host-pooler.region.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection used by `prisma migrate`
DIRECT_URL="postgresql://user:password@host.region.neon.tech/dbname?sslmode=require"

PORT=3001

# Generate a strong random value, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me"

# Optional when the browser frontend is hosted on a different origin.
# Production Vercel rewrites are same-origin and do not require this.
FRONTEND_URL=""

# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Server-side Gemini key from Google AI Studio. Never prefix it with VITE_.
GEMINI_API_KEY=""
# Optional model override for the recruiter assistant.
GEMINI_MODEL="gemini-3.5-flash"
