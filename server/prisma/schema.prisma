generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Profile {
  id             String       @id @default(cuid())
  name           String
  shortName      String
  title          String
  tagline        String
  bio            String
  location       String
  email          String
  phone          String
  photo          String?
  resumeUrl      String?
  updatedAt      DateTime     @updatedAt
  languages      String?
  portfolioUrl   String?
  seoTitle       String?
  seoDescription String?
  professionalSummary String?
  availabilityStatus String?
  availabilityText String?
  responseTime String?
  remoteAvailability String?
  openToOpportunities Boolean @default(true)
  heroLabel String?
  profileReference String?
  whatsappNumber String?
  whatsappMessage String?
  focusAreas String[] @default([])
  experience     Experience[]
  socials        SocialLink[]
}

model Experience {
  id          String  @id @default(cuid())
  milestone   String
  facility    String
  meta        String
  details     String
  order       Int     @default(0)
  profileId   String
  role        String?
  company     String?
  description String?
  startDate   String?
  endDate     String?
  isCurrent   Boolean @default(false)
  location    String?
  workArrangement String?
  bullets     String[] @default([])
  technologies String[] @default([])
  published   Boolean @default(true)
  showOnCv    Boolean @default(true)
  cvDescription String?
  cvBullets   String[] @default([])
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model SocialLink {
  id        String  @id @default(cuid())
  label     String
  url       String
  platform  String @default("link")
  username  String?
  icon      String?
  order     Int @default(0)
  showInHero Boolean @default(true)
  showInContact Boolean @default(true)
  showInFooter Boolean @default(true)
  showOnCv Boolean @default(true)
  published Boolean @default(true)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Technology {
  id       String @id @default(cuid())
  name     String @unique
  category String
  order    Int    @default(0)
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  category String
  order    Int    @default(0)
  status   String @default("verified")
}

model Education {
  id      String  @id @default(cuid())
  school  String
  degree  String
  field   String?
  period  String?
  details String?
  order   Int     @default(0)
  location String?
  startDate String?
  endDate String?
  published Boolean @default(true)
  showOnCv Boolean @default(true)
  cvDescription String?
}

model Certification {
  id     String  @id @default(cuid())
  title  String
  issuer String
  year   String?
  url    String?
  order  Int     @default(0)
  issueDate String?
  expectedDate String?
  duration String?
  credentialId String?
  description String?
  published Boolean @default(true)
  showOnCv Boolean @default(true)
  cvDescription String?
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  type          String
  tagline       String?
  description   String?
  overview      String?
  problem       String?
  solution      String?
  features      String[]
  stack         String[]
  team          String[]
  program       String?
  github        String?
  demo          String?
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  /// Persisted as a six-digit hex accent color (#RRGGBB).
  visual        String   @default("#5966A0")
  order         Int      @default(0)
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  coverImage    String?
  screenshots   String[] @default([])
  myRole        String?
  contributions String[] @default([])
  ownership     String?
  teamSize      Int?
  impactSummary String?
  imageAlt      String?
  showOnCv      Boolean @default(true)
  showOnPortfolio Boolean @default(true)
  cvDescription String?
  cvBullets     String[] @default([])
  architecture  String[] @default([])
  codeDiffs     String[] @default([])
  benchmarks    String[] @default([])
}

model SiteSection {
  key         String   @id
  eyebrow     String?
  heading     String?
  description String?
  ctaLabel    String?
  ctaUrl      String?
  visible     Boolean  @default(true)
  order       Int      @default(0)
  content     Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CvConfiguration {
  id                  String   @id @default("default")
  professionalSummary String?
  header              Json
  application         Json
  master              Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
