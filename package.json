{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "images:optimize": "node scripts/optimize-project-images.mjs",
    "images:gallery": "node scripts/optimize-gallery-covers.mjs",
    "images:portrait": "node scripts/optimize-profile-portrait.mjs",
    "test:e2e": "playwright test",
    "test:landscape": "node --test tests/assistant-response.test.mjs server/test/gemini-stream.test.mjs server/test/portfolio-links.test.mjs",
    "test:api-runtime": "node server/scripts/test-api-runtime.mjs",
    "test:gallery": "node --test tests/gallery-covers.test.mjs",
    "test:portrait": "node --test tests/profile-portrait.test.mjs",
    "test:e2e:install": "playwright install chromium",
    "preview": "vite preview",
    "dev:full": "concurrently -k -n client,server -c cyan,green \"vite\" \"npm --prefix server run dev\"",
    "preview:content": "node scripts/preview-content.mjs",
    "dev:motion": "vite --config vite.motion-preview.config.js"
  },
  "dependencies": {
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@prisma/client": "^6.12.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pdfkit": "^0.19.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "three": "0.180.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prisma": "^6.12.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.12"
  }
}
